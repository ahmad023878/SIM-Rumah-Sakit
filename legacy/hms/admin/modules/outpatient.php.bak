<?php
session(); include('../include/config.php'); require_once __DIR__.'/module_bootstrap.php'; hms_module_require_roles(array('admin','doctor','perawat','rekam_medis'));
if($_SERVER['REQUEST_METHOD']==='POST'){
 hms_module_csrf(); $action=$_POST['action']??'';
 try{
  if($action==='create'){
   $visit=(int)($_POST['visit_id']??0); $doctor=(int)($_POST['doctor_id']??0); $poli=trim($_POST['poli']??'');
   $v=hms_fetch_one($con,'SELECT * FROM hms_patient_visits WHERE id=? AND visit_type=\'RAWAT_JALAN\'','i',array($visit)); if(!$v)throw new RuntimeException('Kunjungan rawat jalan tidak ditemukan.');
   if($poli==='')$poli=$v['poli']??''; if($poli==='')throw new RuntimeException('Poli wajib diisi.');
   $existing=hms_fetch_one($con,'SELECT id FROM hms_outpatient_encounters WHERE visit_id=?','i',array($visit));
   if($existing){hms_set_flash('warning','Kunjungan tersebut sudah memiliki pelayanan rawat jalan.');}
   else{ $st=mysqli_prepare($con,'INSERT INTO hms_outpatient_encounters(visit_id,patient_id,doctor_id,poli,status) VALUES(?,?,?,?,\'TERDAFTAR\')');mysqli_stmt_bind_param($st,'iiis',$visit,$v['patient_id'],$doctor,$poli);mysqli_stmt_execute($st);$id=mysqli_stmt_insert_id($st);mysqli_stmt_close($st);hms_module_workflow_event($con,(int)$v['patient_id'],$visit,null,null,'RAWAT_JALAN','TERDAFTAR','Pelayanan rawat jalan dibuat.');hms_module_audit($con,'CREATE','RAWAT_JALAN','hms_outpatient_encounters',$id,'Pelayanan rawat jalan dibuat');hms_set_flash('success','Pelayanan rawat jalan dibuat.');}
  }
  if($action==='save_clinical'){
   $id=(int)$_POST['encounter_id'];$e=hms_fetch_one($con,'SELECT * FROM hms_outpatient_encounters WHERE id=?','i',array($id));if(!$e)throw new RuntimeException('Pelayanan tidak ditemukan.');
   $anam=trim($_POST['anamnesis']??'');$phys=trim($_POST['physical_exam']??'');$ass=trim($_POST['assessment']??'');$plan=trim($_POST['plan']??'');$code=trim($_POST['diagnosis_code']??'');$diag=trim($_POST['diagnosis_name']??'');$act=trim($_POST['action_text']??'');$serviceId=(int)($_POST['service_id']??0);$doctor=(int)($_POST['doctor_id']??$e['doctor_id']);
   hms_execute($con,"UPDATE hms_outpatient_encounters SET doctor_id=?,anamnesis=?,physical_exam=?,assessment=?,plan=?,diagnosis_code=?,diagnosis_name=?,action_text=?,status='DILAYANI',started_at=COALESCE(started_at,NOW()),updated_at=NOW() WHERE id=?",'isssssssi',array($doctor,$anam,$phys,$ass,$plan,$code,$diag,$act,$id));
   // Mirror clinical content into RME/CPPT so the outpatient encounter is part of the longitudinal record.
   $st=mysqli_prepare($con,'INSERT INTO hms_cppt(patient_id,visit_id,admission_id,author_type,author_id,note_type,subjective,objective,assessment,plan,diagnosis_code,diagnosis_name,action_text) VALUES(?,?,NULL,?,?,?,?,?,?,?,?,?,?)');
   if(!$st)throw new RuntimeException('Gagal membuat RME rawat jalan.');session();$role=hms_module_current_role();$atype=$role==='doctor'?'DOKTER':($role==='perawat'?'PERAWAT':($role==='rekam_medis'?'REKAM_MEDIS':'ADMIN'));$aid=(int)($_SESSION['id']??0);$type='SOAP';
   mysqli_stmt_bind_param($st,'iisissssssss',$e['patient_id'],$e['visit_id'],$atype,$aid,$type,$anam,$phys,$ass,$plan,$code,$diag,$act);if(!mysqli_stmt_execute($st)){ $dbError=mysqli_stmt_error($st); mysqli_stmt_close($st); throw new RuntimeException('Gagal menyimpan RME rawat jalan'.($dbError!==''?': '.$dbError:'.')); }$cppt=mysqli_stmt_insert_id($st);mysqli_stmt_close($st);
   if($serviceId>0){
    $svc=hms_fetch_one($con,'SELECT id,service_code,service_name,service_type,price FROM hms_service_catalog WHERE id=? AND is_active=1','i',array($serviceId));
    if(!$svc) throw new RuntimeException('Jenis pelayanan tidak ditemukan.');
    $already=hms_fetch_one($con,"SELECT id FROM hms_clinical_charges WHERE visit_id=? AND service_id=? AND status<>'CANCELLED' LIMIT 1",'ii',array((int)$e['visit_id'],$serviceId));
    if(!$already){
      $amount=(float)$svc['price'];
      $charge=mysqli_prepare($con,"INSERT INTO hms_clinical_charges(patient_id,visit_id,cppt_id,service_id,service_type,description,qty,unit_price,amount,status,created_by) VALUES(?,?,?,?,?,?,1,?,?, 'POSTED',?)");
      if($charge){ mysqli_stmt_bind_param($charge,'iiiissddi',(int)$e['patient_id'],(int)$e['visit_id'],$cppt,$serviceId,$svc['service_type'],$svc['service_name'],$amount,$amount,$aid); if(!mysqli_stmt_execute($charge)){mysqli_stmt_close($charge);throw new RuntimeException('Gagal membuat charge pelayanan.');} mysqli_stmt_close($charge); }
    }
   }
   hms_module_workflow_event($con,(int)$e['patient_id'],(int)$e['visit_id'],null,null,'RME_ENTRY','SELESAI','SOAP rawat jalan terintegrasi ke RME.');hms_module_audit($con,'UPDATE','RAWAT_JALAN','hms_outpatient_encounters',$id,'Pelayanan klinis rawat jalan diperbarui');hms_set_flash('success','Anamnesis, pemeriksaan, diagnosis dan SOAP tersimpan ke RME.');
  }
  if($action==='complete'){$id=(int)$_POST['encounter_id'];$e=hms_fetch_one($con,'SELECT * FROM hms_outpatient_encounters WHERE id=?','i',array($id));if(!$e)throw new RuntimeException('Pelayanan tidak ditemukan.');hms_execute($con,"UPDATE hms_outpatient_encounters SET status='SELESAI',completed_at=NOW(),updated_at=NOW() WHERE id=?",'i',array($id));hms_execute($con,"UPDATE hms_patient_visits SET status='SELESAI',completed_at=NOW(),updated_at=NOW() WHERE id=?",'i',array($e['visit_id']));hms_module_workflow_event($con,(int)$e['patient_id'],(int)$e['visit_id'],null,null,'RAWAT_JALAN','SELESAI','Pelayanan rawat jalan selesai.');hms_module_audit($con,'STATUS_CHANGE','RAWAT_JALAN','hms_outpatient_encounters',$id,'Pelayanan selesai');hms_set_flash('success','Pelayanan rawat jalan selesai.');}
 }catch(Throwable $ex){hms_set_flash('danger',$ex->getMessage());}
}
$visits=hms_fetch_all($con,"SELECT v.*,p.PatientName,p.medical_record_no FROM hms_patient_visits v JOIN tblpatient p ON p.ID=v.patient_id LEFT JOIN hms_outpatient_encounters o ON o.visit_id=v.id WHERE v.visit_type='RAWAT_JALAN' AND o.id IS NULL AND v.status IN ('MENUNGGU','DIPANGGIL','DILAYANI') ORDER BY v.visit_date DESC,v.id DESC LIMIT 300");
$doctors=hms_fetch_all($con,'SELECT id,doctorName,specilization FROM doctors ORDER BY doctorName');$services=hms_fetch_all($con,'SELECT id,service_code,service_name,service_type,price FROM hms_service_catalog WHERE is_active=1 ORDER BY service_type,service_name');$icds=hms_fetch_all($con,'SELECT code,description FROM hms_icd10 WHERE is_active=1 ORDER BY code LIMIT 2000');
$rows=hms_fetch_all($con,'SELECT o.*,v.registration_no,v.queue_no,p.PatientName,p.medical_record_no,d.doctorName FROM hms_outpatient_encounters o JOIN hms_patient_visits v ON v.id=o.visit_id JOIN tblpatient p ON p.ID=o.patient_id LEFT JOIN doctors d ON d.id=o.doctor_id ORDER BY o.id DESC LIMIT 100');
$role=hms_module_current_role();hms_layout_header('Rawat Jalan / Poliklinik',$role,'operations');
?>
<div class="hms-page-title"><div><h1>Rawat Jalan / Poliklinik</h1><div class="text-muted">Registrasi pelayanan poli, antrean, dokter, anamnesis, pemeriksaan, diagnosis ICD-10, tindakan dan integrasi RME.</div></div></div>
<div class="hms-card p-3 mb-4"><h2 class="h5">Registrasikan Kunjungan ke Poli</h2><form method="post" class="row g-3"><?php echo hms_csrf_field(); ?><input type="hidden" name="action" value="create"><div class="col-md-6"><label class="form-label">Kunjungan</label><select name="visit_id" class="form-select" required><option value="">Pilih kunjungan</option><?php foreach($visits as $v){ ?><option value="<?php echo (int)$v['id']; ?>"><?php echo hms_e(($v['medical_record_no']?:'RM-'.$v['patient_id']).' | '.$v['registration_no'].' | '.$v['queue_no'].' | '.$v['PatientName'].' | '.$v['poli']); ?></option><?php } ?></select></div><div class="col-md-3"><label class="form-label">Dokter</label><select name="doctor_id" class="form-select"><option value="0">Pilih dokter</option><?php foreach($doctors as $d){ ?><option value="<?php echo (int)$d['id']; ?>"><?php echo hms_e($d['doctorName'].' - '.$d['specilization']); ?></option><?php } ?></select></div><div class="col-md-3"><label class="form-label">Poli</label><input name="poli" class="form-control" required></div><div class="col-12"><button class="btn btn-primary">Mulai Pelayanan Rawat Jalan</button></div></form></div>
<div class="hms-card p-3 mb-4"><h2 class="h5">Catatan Klinis / SOAP</h2><form method="post" class="row g-3"><?php echo hms_csrf_field(); ?><input type="hidden" name="action" value="save_clinical"><div class="col-md-4"><label class="form-label">Pelayanan</label><select name="encounter_id" class="form-select" required><option value="">Pilih</option><?php foreach($rows as $r){ if($r['status']!=='SELESAI'&&$r['status']!=='BATAL'){ ?><option value="<?php echo (int)$r['id']; ?>"><?php echo hms_e($r['registration_no'].' | '.$r['PatientName'].' | '.$r['poli']); ?></option><?php }} ?></select></div><div class="col-md-4"><label class="form-label">Dokter</label><select name="doctor_id" class="form-select"><option value="0">Gunakan dokter saat registrasi</option><?php foreach($doctors as $d){ ?><option value="<?php echo (int)$d['id']; ?>"><?php echo hms_e($d['doctorName']); ?></option><?php } ?></select></div><div class="col-md-4"><label class="form-label">Jenis Pelayanan / Tarif</label><select name="service_id" class="form-select"><option value="0">Tidak menambahkan charge</option><?php foreach($services as $sv){ ?><option value="<?php echo (int)$sv['id']; ?>"><?php echo hms_e($sv['service_name'].' - Rp '.number_format((float)$sv['price'],0,',','.')); ?></option><?php } ?></select></div><div class="col-md-4"><label class="form-label">Diagnosis ICD-10</label><select name="diagnosis_code" class="form-select"><option value="">Pilih</option><?php foreach($icds as $ic){ ?><option value="<?php echo hms_e($ic['code']); ?>"><?php echo hms_e($ic['code'].' - '.$ic['description']); ?></option><?php } ?></select></div><div class="col-md-4"><label class="form-label">Nama Diagnosis</label><input name="diagnosis_name" class="form-control"></div><div class="col-md-4"><label class="form-label">Anamnesis</label><textarea name="anamnesis" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label class="form-label">Pemeriksaan Fisik</label><textarea name="physical_exam" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label class="form-label">Assessment</label><textarea name="assessment" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label class="form-label">Plan</label><textarea name="plan" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label class="form-label">Tindakan</label><textarea name="action_text" class="form-control" rows="3"></textarea></div><div class="col-12"><button class="btn btn-success">Simpan ke RME</button></div></form></div>
<div class="hms-card p-3"><h2 class="h5">Daftar Pelayanan</h2><div class="table-responsive"><table class="table table-hover"><thead><tr><th>No. RM</th><th>Registrasi/Antrean</th><th>Pasien</th><th>Poli</th><th>Dokter</th><th>Status</th><th>Aksi</th></tr></thead><tbody><?php foreach($rows as $r){ ?><tr><td><?php echo hms_e($r['medical_record_no']); ?></td><td><?php echo hms_e($r['registration_no'].' / '.$r['queue_no']); ?></td><td><?php echo hms_e($r['PatientName']); ?></td><td><?php echo hms_e($r['poli']); ?></td><td><?php echo hms_e($r['doctorName']??'-'); ?></td><td><?php echo hms_status_badge($r['status']); ?></td><td><?php if($r['status']!=='SELESAI'){ ?><form method="post" class="d-inline"><?php echo hms_csrf_field(); ?><input type="hidden" name="action" value="complete"><input type="hidden" name="encounter_id" value="<?php echo (int)$r['id']; ?>"><button class="btn btn-sm btn-outline-success">Selesai</button></form><?php } ?></td></tr><?php } ?></tbody></table></div></div>
<?php hms_layout_footer(); ?>
